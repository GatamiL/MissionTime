<Window x:Class="MissionTime.Views.Employees"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник сотрудников" Height="500" Width="900"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource StandardWindow}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Фильтр -->
            <RowDefinition Height="*"/>    <!-- Таблица -->
            <RowDefinition Height="Auto"/> <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Фильтр -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Показывать уволенных:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox IsChecked="{Binding ShowFired}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Таблица (DataGrid) -->
        <DataGrid Grid.Row="1" 
              ItemsSource="{Binding Employees}" 
              SelectedItem="{Binding SelectedEmployee}"
              AutoGenerateColumns="False" IsReadOnly="True"
              Style="{StaticResource StandardDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding Fio}" Width="*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding PositionName}" Width="*"/>
                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepartmentName}" Width="*"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="FontStyle" Value="Normal"/>
                    <Setter Property="Foreground" Value="#2C3E50"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F1F3F5"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsFired}" Value="True">
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="Foreground" Value="#ADB5BD"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- Кнопки управления (Внизу, растянуты на всю ширину) -->
        <UniformGrid Grid.Row="2" Columns="5" Margin="0,15,0,0">
            <Button Content="Добавить сотрудника" Click="btnAdd_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,5,0"/>
            <Button Content="Изменить ФИО" Click="btnEditFio_Click" Style="{StaticResource SecondaryButton}" Margin="5,0,5,0"/>
            <Button Content="Перевести" Click="btnTransfer_Click" Style="{StaticResource SecondaryButton}" Margin="5,0,5,0"/>
            <Button Content="Уволить" Click="btnFire_Click" Style="{StaticResource SecondaryButton}" Margin="5,0,5,0"/>
            <Button Content="История переводов" Click="btnHistory_Click" Style="{StaticResource SecondaryButton}" Margin="5,0,0,0"/>
        </UniformGrid>
    </Grid>
</Window>
