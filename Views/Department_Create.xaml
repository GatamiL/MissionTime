<Window x:Class="MissionTime.Views.Department_Create"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:MissionTime.Services"
        Title="Создать подразделение" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" Style="{StaticResource StandardWindow}">

    <Window.Resources>
        <infra:LevelToMarginConverter x:Key="LevelToMargin"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Полное название:" Style="{StaticResource StandardText}" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" 
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{StaticResource StandardTextBox}" 
                 Margin="0,0,0,15"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalContentAlignment="Top" 
                 MinHeight="60"
                 Padding="5"
                 VerticalScrollBarVisibility="Auto"/>
        
        <StackPanel Grid.Row="2">
            <TextBlock Text="Краткое название:" Style="{StaticResource StandardText}"/>
            <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource StandardTextBox}" Margin="0,5,0,15"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="Внутри подразделения (Родитель):" Style="{StaticResource StandardText}"/>
            <ComboBox ItemsSource="{Binding ParentCandidates}" 
                      SelectedItem="{Binding SelectedParent}"
                      Style="{StaticResource StandardComboBox}" Margin="0,5,0,15">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Margin="{Binding Level, Converter={StaticResource LevelToMargin}}"/>
                            <TextBlock Text="└ " Foreground="Gray">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Id}" Value="-1">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <CheckBox Content="Назначить ответственного" IsChecked="{Binding HasResponsible}" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Employees}" 
                      SelectedItem="{Binding SelectedEmployee}"
                      DisplayMemberPath="Fio"
                      IsEnabled="{Binding HasResponsible}"
                      Style="{StaticResource StandardComboBox}" Margin="0,0,0,20"/>
        </StackPanel>

        <!-- Кнопки (растянуты пополам) -->
        <UniformGrid Grid.Row="5" Columns="2">
            <Button Content="Создать" Margin="0,0,5,0" Style="{StaticResource PrimaryButton}" Click="btnSave_Click" IsDefault="True"/>
            <Button Content="Отмена" Margin="5,0,0,0" Style="{StaticResource SecondaryButton}" Click="btnCancel_Click" IsCancel="True"/>
        </UniformGrid>
    </Grid>
</Window>