<Window x:Class="MissionTime.Views.Employee_History"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История перемещений" Height="450" Width="750"
        WindowStartupLocation="CenterOwner" Style="{StaticResource StandardWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- Панель кнопок -->
        </Grid.RowDefinitions>

        <!-- Шапка с именем сотрудника -->
        <Border Grid.Row="0" Background="#E7F1FF" CornerRadius="5" Padding="15" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Личное дело: " FontSize="16" Foreground="#495057"/>
                <TextBlock x:Name="lblEmployeeName" Text="ФИО" FontSize="16" FontWeight="Bold" Foreground="#0078D7"/>
            </StackPanel>
        </Border>

        <!-- Таблица истории -->
        <DataGrid Grid.Row="1" x:Name="dgHistory" 
                  Style="{StaticResource StandardDataGrid}"
                  AutoGenerateColumns="False"
                  VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding StartDate}" Width="100"/>

                <!-- Кастомная колонка для красивого текста события -->
                <DataGridTemplateColumn Header="Событие" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Переносим логику цвета прямо в стиль TextBlock -->
                            <TextBlock Text="{Binding ActionText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- Цвет по умолчанию (например, для Перевода) -->
                                        <Setter Property="Foreground" Value="#F59F00"/>
                                        <Style.Triggers>
                                            <!-- Если Прием (Action = 1) -->
                                            <DataTrigger Binding="{Binding Action}" Value="1">
                                                <Setter Property="Foreground" Value="#2F9E44"/>
                                            </DataTrigger>
                                            <!-- Если Увольнение (Action = 3) -->
                                            <DataTrigger Binding="{Binding Action}" Value="3">
                                                <Setter Property="Foreground" Value="#E03131"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Подразделение" Binding="{Binding DepName}" Width="1.5*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding PosName}" Width="1.5*"/>
                <DataGridTextColumn Header="Примечание / Основание" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки управления -->
        <DockPanel Grid.Row="2" LastChildFill="False">
            <Button Content="Отменить последнюю операцию" 
                    Click="btnUndo_Click" 
                    Background="#F8F9FA" Foreground="#E03131" BorderBrush="#DEE2E6" FontWeight="SemiBold"
                    Padding="15,6" DockPanel.Dock="Left"/>
            
            <Button Content="Закрыть" 
                    Click="btnClose_Click" 
                    Style="{StaticResource PrimaryButton}" 
                    Width="120" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>