<Window x:Class="MissionTime.Views.EmployeePosition_Edit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="180" Width="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Style="{StaticResource StandardWindow}">
    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Название должности:" Style="{StaticResource StandardText}" Margin="0,0,0,10"/>

            <TextBox x:Name="txtName" Text="{Binding PositionName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource StandardTextBox}" VerticalContentAlignment="Center"
                     KeyDown="txtName_KeyDown"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Сохранить" Width="100" Margin="0,0,10,0"
                        Style="{StaticResource PrimaryButton}" 
                        Click="btnSave_Click"
                        IsDefault="True"/>
                <Button Content="Отмена" Width="80" 
                        Style="{StaticResource SecondaryButton}" 
                        Click="btnCancel_Click"
                        IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>