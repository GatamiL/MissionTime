<Window x:Class="MissionTime.Views.ListOfWork_Edit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование вида работы" Height="350" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource StandardWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Наименование работы:" Style="{StaticResource StandardText}" Margin="0,0,0,5"/>
        
        <TextBox x:Name="txtName" Grid.Row="1" Style="{StaticResource StandardTextBox}" Margin="0,0,0,15"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Padding="5"/>

        <TextBlock Grid.Row="2" Text="Специальный код (для табеля):" Style="{StaticResource StandardText}" Margin="0,0,0,5"/>
        
        <TextBox x:Name="txtCode" Grid.Row="3" Style="{StaticResource StandardTextBox}" Margin="0,0,0,20"/>

        <UniformGrid Grid.Row="4" Columns="2">
            <Button Content="Сохранить" Margin="0,0,5,0" Click="btnSave_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            <Button Content="Отмена" Margin="5,0,0,0" IsCancel="True" Style="{StaticResource SecondaryButton}"/>
        </UniformGrid>
    </Grid>
</Window>