<Window x:Class="MissionTime.Views.Employee_Create"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прием на работу" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource StandardWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- ФИО -->
            <RowDefinition Height="Auto"/>
            <!-- Должность -->
            <RowDefinition Height="Auto"/>
            <!-- Дата -->
            <RowDefinition Height="*"/>
            <!-- Подразделение -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- ФИО -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="ФИО сотрудника:" Style="{StaticResource StandardText}" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFio" Style="{StaticResource StandardTextBox}"/>
        </StackPanel>

        <!-- Должность -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Должность:" Style="{StaticResource StandardText}" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbPositions" DisplayMemberPath="Name" SelectedValuePath="Id"
                      Style="{StaticResource StandardComboBox}"/>
        </StackPanel>

        <!-- Дата приема -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Дата приема на работу:" Style="{StaticResource StandardText}" Margin="0,0,0,5"/>
            <DatePicker x:Name="dpStartDate" FirstDayOfWeek="Monday" />
        </StackPanel>

        <!-- Подразделение -->
        <DockPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock DockPanel.Dock="Top" Text="Выберите подразделение:" 
                       Style="{StaticResource StandardText}" Margin="0,0,0,5"/>
            <Border BorderBrush="#CED4DA" BorderThickness="1" CornerRadius="4">
                <TreeView x:Name="tvDepartments" BorderThickness="0">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" Margin="2"/>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
        </DockPanel>

        <!-- Кнопки (растянуты пополам) -->
        <UniformGrid Grid.Row="4" Columns="2">
            <Button Content="Принять" Margin="0,0,5,0" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="btnSave_Click"/>
            <Button Content="Отмена" Margin="5,0,0,0" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="btnCancel_Click"/>
        </UniformGrid>
    </Grid>
</Window>