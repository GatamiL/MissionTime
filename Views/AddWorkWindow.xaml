<Window x:Class="MissionTime.Views.AddWorkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление работы" Height="250" Width="450" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource StandardWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Инфо -->
            <RowDefinition Height="Auto"/>
            <!-- Выбор работы -->
            <RowDefinition Height="*"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock x:Name="lblEmployee" Text="Сотрудник: ..." FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock x:Name="lblProgram" Text="Программа: ..." Foreground="#4B5563" FontSize="13"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Вид работы:" Margin="0,0,0,5" Foreground="#6B7280" FontSize="12"/>
            <ComboBox x:Name="cbWorkType" 
                      SelectedValuePath="Id">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SpecialCode}" FontWeight="Bold" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="2" VerticalAlignment="Bottom">
            <Button x:Name="btnOk" Content="Добавить" Margin="0,0,5,0" Click="btnOk_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Отмена" Margin="5,0,0,0" Click="btnCancel_Click" IsCancel="True" Style="{StaticResource StandardButton}"/>
        </UniformGrid>
    </Grid>
</Window>