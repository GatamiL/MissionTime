<Window x:Class="MissionTime.Views.EmployeeSignatures"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MissionTime.Views"
        xmlns:vm="clr-namespace:MissionTime.ViewModels"
        mc:Ignorable="d"
        Title="Управление электронными подписями" 
        Height="650" Width="1000"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontSize="{DynamicResource MainFontSize}"
        FontFamily="{DynamicResource MainFontFamily}">
    
    <Window.Resources>
        <!-- Слайдер красивый -->
        <Style x:Key="ConfigSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TickPlacement" Value="None"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F8F9FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ПАНЕЛЬ: СПИСОК -->
        <Grid Grid.Column="0" Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#F1F3F5" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="15,10">
                <TextBlock Text="Сотрудники" FontWeight="SemiBold" Foreground="#495057" FontSize="16"/>
            </Border>

            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding Employees}" 
                     SelectedItem="{Binding SelectedEmployee}"
                     DisplayMemberPath="Fio"
                     Margin="10"
                     BorderThickness="1"
                     BorderBrush="#DEE2E6"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- РАЗДЕЛИТЕЛЬ -->
        <GridSplitter Grid.Column="1" Width="4" Background="#E9ECEF" HorizontalAlignment="Center"/>

        <!-- ПРАВАЯ ПАНЕЛЬ: РЕДАКТОР -->
        <Grid Grid.Column="2" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. ПРЕДПРОСМОТР (Preview) -->
            <GroupBox Grid.Row="0" Header="Предпросмотр (как в Excel)" BorderThickness="1" BorderBrush="#DEE2E6" Background="White">
                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="5,0"/>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>
                
                <Grid Background="#E9ECEF" Margin="10">
                    <!-- Область имитации листа Excel -->
                    <Viewbox Stretch="Uniform">
                        <Grid Width="400" Height="150" Background="White">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="15" Direction="315" Opacity="0.1" ShadowDepth="3"/>
                            </Grid.Effect>

                            <!-- Имитация ячейки с полочкой -->
                            <!-- Линия снизу для подписи -->
                            <Border VerticalAlignment="Bottom" Height="1" Background="Black" Margin="40,0,40,40"/>
                            
                            <TextBlock Text="Подпись ответственного лица" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Bottom" 
                                       Margin="0,0,0,20" 
                                       FontSize="11" Foreground="#6C757D" FontStyle="Italic"/>

                            <!-- КОНТЕЙНЕР ДЛЯ ПОДПИСИ -->
                            <!-- Grid с выравниванием по низу идеально имитирует положение над полочкой -->
                            <Grid ClipToBounds="True" Margin="40,20,40,40" Background="Transparent">
                                <Image Source="{Binding ImageSource}" 
                                       Stretch="Uniform"
                                       Width="150"
                                       Opacity="0.85"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Left"
                                       RenderTransformOrigin="0,1">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <!-- Масштаб: привязка к Scale -->
                                            <ScaleTransform ScaleX="{Binding ScaleRatio}" ScaleY="{Binding ScaleRatio}"/>
                                            <!-- Смещение: X=вправо, Y=вверх/вниз относительно полочки -->
                                            <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                            
                            <!-- Рамка типа выделенная ячейка Excel -->
                            <Border BorderBrush="#217346" BorderThickness="2" Visibility="Visible"/>
                        </Grid>
                    </Viewbox>
                </Grid>
            </GroupBox>

            <!-- 2. ПАНЕЛЬ НАСТРОЕК -->
            <StackPanel Grid.Row="1" Margin="0,15,0,0" IsEnabled="{Binding IsControlsEnabled}">
                <Border Background="White" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="4" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>

                            <!-- Отступ X -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Смещение по гор. (X):" VerticalAlignment="Center" Foreground="#495057"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="-100" Maximum="250" Value="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigSlider}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding OffsetX, StringFormat=\{0:F0\}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>

                            <!-- Отступ Y -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Смещение по верт. (Y):" VerticalAlignment="Center" Foreground="#495057" Margin="0,10,0,0"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="-100" Maximum="100" Value="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigSlider}" Margin="0,15,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding OffsetY, StringFormat=\{0:F0\}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0"/>

                            <!-- Масштаб -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Масштаб (%):" VerticalAlignment="Center" Foreground="#495057" Margin="0,10,0,0"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="300" Value="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ConfigSlider}" Margin="0,15,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Scale, StringFormat=\{0:F0\}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Margin="0,10,0,0"/>
                        </Grid>

                        <!-- КНОПКИ -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30,0,0,0" MinWidth="180">
                            <Button Content="Загрузить PNG..." 
                                    Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding LoadFileCommand}"
                                    Margin="0,0,0,10"/>
                            
                            <Button Content="Очистить" 
                                    Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding ClearCommand}"
                                    Foreground="#E74C3C"
                                    Margin="0,0,0,20"/>
                            
                            <Button Content="СОХРАНИТЬ" 
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveCommand}"
                                    Height="40"
                                    FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
