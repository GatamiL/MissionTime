<Window x:Class="MissionTime.Views.DbSelect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vms="clr-namespace:MissionTime.ViewModels"
        Title="MissionTime" Height="350" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource StandardWindow}">

    <Window.DataContext>
        <vms:DbSelectViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Image Source="/Assets/app_icon.png" Width="48" Height="48" Margin="0,0,15,0" Grid.Column="0" VerticalAlignment="Center"/>
            
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="MissionTime" Style="{StaticResource HeaderResultText}" Margin="0" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Выберите или создайте базу данных" 
                           Style="{StaticResource HintItalicText}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="lbDatabases" Grid.Column="0" Margin="0,0,15,0" 
                     BorderBrush="#CED4DA" BorderThickness="1" 
                     Padding="5" FontSize="14"
                     ItemsSource="{Binding DatabaseFiles}"
                     SelectedItem="{Binding SelectedFile}">
            </ListBox>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Content="ВЫБРАТЬ" Grid.Row="0" 
                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" 
                        Command="{Binding SelectCommand}"
                        IsDefault="True"/>

                <Button Content="Создать" Grid.Row="1" 
                        Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" 
                        Command="{Binding CreateCommand}"/>

                <Button Content="Удалить" Grid.Row="2" 
                        Style="{StaticResource SecondaryButton}" Foreground="#E74C3C" 
                        Command="{Binding DeleteCommand}"/>

                <Button Content="Выход" Grid.Row="4" 
                        Style="{StaticResource SecondaryButton}" 
                        Command="{Binding ExitCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</Window>