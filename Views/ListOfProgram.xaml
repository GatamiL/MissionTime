<Window x:Class="MissionTime.Views.ListOfProgram"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник программ" Height="500" Width="600" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Style="{StaticResource StandardWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgPrograms" Style="{StaticResource StandardDataGrid}" 
                  AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Сокр. назв." Binding="{Binding ShortName}" Width="120"/>
                <DataGridTextColumn Header="Полное наименование" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Дата начала" Binding="{Binding DateStart}" Width="100"/>
                <DataGridTextColumn Header="Дата окончания" Binding="{Binding DateEnd}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Кнопки (растянуты поровну) -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,15,0,0">
            <Button Content="Добавить" Margin="0,0,5,0" Click="btnAdd_Click" Style="{StaticResource PrimaryButton}"/>
            <Button Content="Изменить" Margin="5,0,5,0" Click="btnEdit_Click" Style="{StaticResource SecondaryButton}"/>
            <Button Content="Удалить" Margin="5,0,0,0" Click="btnDelete_Click" Style="{StaticResource DangerButton}"/>
        </UniformGrid>
    </Grid>
</Window>