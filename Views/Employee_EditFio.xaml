<Window x:Class="MissionTime.Views.Employee_EditFio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменение данных" Height="195" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource StandardWindow}">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Новое ФИО сотрудника:" 
                       Style="{StaticResource StandardText}" Margin="0,0,0,10"/>

            <TextBox x:Name="txtFio" 
                     Style="{StaticResource StandardTextBox}" 
                     VerticalContentAlignment="Center"
                     FontSize="14"/>

            <UniformGrid Columns="2" Margin="0,20,0,0">
                <Button Content="Сохранить" IsDefault="True" Margin="0,0,5,0"
                        Style="{StaticResource PrimaryButton}" Click="btnSave_Click"/>
                <Button Content="Отмена" Margin="5,0,0,0"
                        Style="{StaticResource SecondaryButton}" IsCancel="True"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>