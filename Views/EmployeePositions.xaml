<Window x:Class="MissionTime.Views.EmployeePositions"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Справочник должностей" Height="400" Width="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource StandardWindow}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="LbPositions" Grid.Row="0"
                 ItemsSource="{Binding Positions}"
                 SelectedItem="{Binding SelectedPosition}"
                 DisplayMemberPath="Name"
                 BorderBrush="#CED4DA" BorderThickness="1"/>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,15,0,0">
            <Button x:Name="btnCreate" Content="Добавить" 
                    Style="{StaticResource PrimaryButton}" Margin="0,0,5,0"
                    Command="{Binding CreateCommand}"/>

            <Button x:Name="btnEdit" Content="Изменить" 
                    Style="{StaticResource SecondaryButton}" Margin="5,0,5,0"
                    Command="{Binding EditCommand}"/>

            <Button x:Name="btnDelete" Content="Удалить" 
                    Style="{StaticResource SecondaryButton}" Foreground="#E74C3C" Margin="5,0,0,0"
                    Command="{Binding DeleteCommand}"/>
        </UniformGrid>
    </Grid>
</Window>