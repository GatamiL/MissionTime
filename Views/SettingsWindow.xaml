<Window x:Class="MissionTime.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="420" Width="500" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource StandardWindow}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки приложения" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Тема (Цвет в виде кружочков) -->
                <TextBlock Text="Цветовая схема (Тема):" FontWeight="SemiBold" Margin="0,0,0,10"/>
                
                <ListBox x:Name="lbTheme" SelectedValuePath="Hex" Margin="0,0,0,20" 
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- Внешний контур для отображения выделения -->
                                        <Border x:Name="OuterCircle" BorderThickness="2" BorderBrush="Transparent" CornerRadius="25" Padding="4" Margin="0,0,10,0">
                                            <Grid>
                                                <!-- Сам цветной кружок -->
                                                <Ellipse Width="35" Height="35" Fill="{Binding Hex}" Stroke="#DDDDDD" StrokeThickness="1"/>
                                                
                                                <!-- Белая точка по центру если выбрано, для акцента -->
                                                <Ellipse x:Name="InnerDot" Width="10" Height="10" Fill="White" Visibility="Hidden"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="OuterCircle" Property="BorderBrush" Value="#DEE2E6"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <!-- Делаем ободок в цвет самой темы -->
                                                <Setter TargetName="OuterCircle" Property="BorderBrush" Value="{Binding Hex}"/>
                                                <Setter TargetName="InnerDot" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Resources>
                    <!-- Делаем горизонтальное расположение в ряд -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <!-- Шрифт -->
                <TextBlock Text="Шрифт интерфейса:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbFont" Margin="0,0,0,15" Style="{StaticResource StandardComboBox}"/>

                <!-- Размер -->
                <TextBlock Text="Размер шрифта:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbFontSize" Margin="0,0,0,25" Style="{StaticResource StandardComboBox}"/>

                <Separator Margin="0,0,0,15"/>

                <!-- База данных -->
                <TextBlock Text="Текущая база данных:" FontWeight="SemiBold" Foreground="#495057" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDbPath" IsReadOnly="True" Background="#F8F9FA" Foreground="#6C757D" Margin="0,0,0,10" Padding="5" TextWrapping="NoWrap"/>
                <Button Content="🔄 Сменить базу данных..." Click="btnChangeDb_Click" HorizontalAlignment="Left" Padding="15,5" Style="{StaticResource SecondaryButton}"/>
            </StackPanel>
        </ScrollViewer>

        <UniformGrid Grid.Row="2" Columns="2" Margin="0,15,0,0">
            <Button Content="Сохранить" Margin="0,0,5,0" Click="btnSave_Click" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
            <Button Content="Отмена" Margin="5,0,0,0" Click="btnClose_Click" Style="{StaticResource StandardButton}" IsCancel="True"/>
        </UniformGrid>
    </Grid>
</Window>
