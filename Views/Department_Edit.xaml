<Window x:Class="MissionTime.Views.Department_Edit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать подразделение" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" Style="{StaticResource StandardWindow}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Полное название:" Style="{StaticResource StandardText}" Margin="0,0,0,5"/>
        <TextBox Grid.Row="1" 
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{StaticResource StandardTextBox}" 
                 Margin="0,0,0,15"
                 TextWrapping="Wrap" 
                 AcceptsReturn="True" 
                 Height="Auto"
                 VerticalAlignment="Stretch"
                 VerticalContentAlignment="Top"
                 Padding="5"
                 VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Краткое название:" Style="{StaticResource StandardText}"/>
            <TextBox Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource StandardTextBox}" Margin="0,5,0,15"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <CheckBox Content="Назначить ответственного" 
                      IsChecked="{Binding HasResponsible, UpdateSourceTrigger=PropertyChanged}" 
                      Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Employees}" 
                      SelectedItem="{Binding SelectedEmployee}"
                      DisplayMemberPath="Fio"
                      IsEnabled="{Binding HasResponsible}"
                      Style="{StaticResource StandardComboBox}" Margin="0,0,0,20"/>
        </StackPanel>

        <UniformGrid Grid.Row="4" Columns="2">
            <Button Content="Сохранить" Margin="0,0,5,0"
                    Style="{StaticResource PrimaryButton}" 
                    Click="btnSave_Click"
                    IsDefault="True"/>
            <Button Content="Отмена" Margin="5,0,0,0"
                    Style="{StaticResource SecondaryButton}" 
                    Click="btnCancel_Click"
                    IsCancel="True"/>
        </UniformGrid>
    </Grid>
</Window>